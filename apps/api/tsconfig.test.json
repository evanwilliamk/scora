// Typecheck only: covers test/ and scripts/, which tsconfig.json leaves out.
// ES2022 module because tests use top-level await (they run under tsx, never emitted).
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ES2022"
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*"]
}
